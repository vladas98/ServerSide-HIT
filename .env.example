# MongoDB Atlas connection string. Every process connects with this.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cost-manager?retryWrites=true&w=majority

# One port per microservice (only needed when all four run on the same machine).
PORT_LOGS=3001
PORT_USERS=3002
PORT_COSTS=3003
PORT_ABOUT=3004

# The costs-service calls the users-service over HTTP to verify a userid
# exists before adding a cost item. Point this at wherever users-service is
# actually reachable (localhost while developing, its public URL once deployed).
USERS_SERVICE_URL=http://localhost:3002

# Team member names returned by /api/about. Hardcoded here instead of in the
# database, since the DB must be submitted empty except for the seed user.
TEAM_MEMBER_1_FIRST_NAME=Omer
TEAM_MEMBER_1_LAST_NAME=Levi
TEAM_MEMBER_2_FIRST_NAME=Vlada
TEAM_MEMBER_2_LAST_NAME=Savitski
